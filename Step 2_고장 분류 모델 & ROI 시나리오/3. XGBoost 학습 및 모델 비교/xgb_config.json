{
 "model": "XGBClassifier",
 "params": {
  "n_estimators": 200,
  "max_depth": 6,
  "learning_rate": 0.1,
  "eval_metric": "aucpr",
  "random_state": 42,
  "scale_pos_weight": 1
 },
 "threshold": 0.5,
 "features": [
  "air_temp",
  "process_temp",
  "rpm",
  "torque",
  "tool_wear",
  "temp_diff",
  "power",
  "tool_torque_interaction",
  "Type_H",
  "Type_L",
  "Type_M"
 ]
}